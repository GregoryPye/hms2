{
  "name": "hms2-environment-smoke",
  "private": true,
  "version": "1.0.0",
  "description": "Test-only tooling; does not install the private production asset dependency.",
  "scripts": {
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@vue/test-utils": "1.3.6",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "vue": "2.7.16",
    "vue-template-compiler": "2.7.16"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/smoke.test.cjs"
    ],
    "cacheDirectory": "/tmp/jest"
  }
}
