{
  "name": "hms2-environment-smoke",
  "private": true,
  "version": "1.0.0",
  "description": "Test-only tooling; does not install the private production asset dependency.",
  "scripts": {
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@vue/test-utils": "1.3.6",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "vue": "2.7.16",
    "vue-template-compiler": "2.7.16",
    "@vue/vue2-jest": "29.2.6",
    "@babel/core": "7.29.7",
    "babel-jest": "29.7.0",
    "@babel/plugin-transform-modules-commonjs": "7.27.1",
    "moment": "2.30.1",
    "moment-timezone": "0.5.48",
    "humanize-duration": "3.33.1",
    "jquery": "3.5.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/*.test.cjs"
    ],
    "cacheDirectory": "/tmp/jest",
    "transform": {
      "^.+\\.vue$": "<rootDir>/transform.cjs"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/support/setup.cjs"
    ],
    "moduleNameMapper": {
      "^@fullcalendar/vue$": "<rootDir>/support/fullcalendar.cjs",
      "^@fullcalendar/.*$": "<rootDir>/support/plugin.cjs",
      "^vue-loading-overlay$": "<rootDir>/support/loading.cjs",
      "^select2/dist/js/select2.full$": "<rootDir>/support/plugin.cjs"
    },
    "collectCoverageFrom": [
      "source/**/*.vue"
    ],
    "coverageDirectory": "/tmp/frontend-coverage",
    "coverageReporters": [
      "json",
      "json-summary",
      "text"
    ],
    "clearMocks": true
  }
}
